# Local env
web/.env
web/.env.local

# Mobile app — removed from the repo (Expo/React Native client, kept locally
# only). Untracked; do not push. Anchored to the repo root so it does NOT also
# match web/app/ (the Next.js App Router dir).
/app/

# Data (raw downloads + caches — all too large / regenerable for git; >100 MB
# hits GitHub's hard limit). Ignore everything under data/, nested caches
# included, keeping only the .gitkeep placeholder. Every dataset + cache here
# is rebuildable from the scripts, so none of it is ever committed.
data/*
!data/.gitkeep

# Runtime caches (NDVI per-location JSON files, etc.)
api/cache/

# OS / editors
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code runtime artifacts (lock files, local-only settings)
.claude/*.lock
.claude/settings.local.json

# Build outputs
*.tsbuildinfo
ios/
android/

