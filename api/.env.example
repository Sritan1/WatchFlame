# Copy to .env and fill in real values. Never commit .env.
NASA_FIRMS_API_KEY=
OPENWEATHERMAP_API_KEY=

# Copernicus Data Space Ecosystem (CDSE) — free Sentinel-2 satellite data
# used for the NDVI vegetation-stress signal on the Status screen.
# Register at https://dataspace.copernicus.eu/ → User Settings → OAuth clients.
# Free tier; required for V4 NDVI features (without it, /risk falls back to
# the calendar season multiplier).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_INSTANCE_URL=https://sh.dataspace.copernicus.eu

# Defaults are fine for local dev
FIRMS_SOURCE=VIIRS_SNPP_NRT
CACHE_TTL_SECONDS=300

# ── Security ────────────────────────────────────────────────────────────────
# dev | prod. In prod the app refuses to start with a wildcard origin or
# missing required secrets (NASA_FIRMS_API_KEY, OPENWEATHERMAP_API_KEY).
ENVIRONMENT=dev

# Comma-separated CORS allowlist. "*" is dev-only; set the real origins in prod,
# e.g. ALLOWED_ORIGINS=https://ember-watch.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Rate limiting (slowapi limit strings). Tiered: cheap cached endpoints inherit
# the default; the upstream-cost endpoints (/risk /trajectory /weather /geocode
# /shelters) use the tighter "expensive" bucket.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_EXPENSIVE=20/minute
RATE_LIMIT_CHEAP=120/minute

# Max accepted request body size in bytes (guards POST /risk).
MAX_REQUEST_BYTES=16384
