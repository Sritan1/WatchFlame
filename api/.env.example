# Copy to .env and fill in real values. Never commit .env.
NASA_FIRMS_API_KEY=
OPENWEATHERMAP_API_KEY=

# Free Sentinel-2 data for the NDVI signal on Status. Register at
# https://dataspace.copernicus.eu/ under User Settings, OAuth clients. Without it
# /risk falls back to the calendar season multiplier.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_INSTANCE_URL=https://sh.dataspace.copernicus.eu

# Several FIRMS products, merged and deduped, so one satellite's NRT lag can't
# blank the map. The old single FIRMS_SOURCE still works.
FIRMS_SOURCES=VIIRS_NOAA20_NRT,VIIRS_SNPP_NRT,VIIRS_NOAA21_NRT
CACHE_TTL_SECONDS=300

# Security
# dev or prod. Prod refuses to boot with a wildcard origin or a missing secret.
ENVIRONMENT=dev

# CORS allowlist. "*" is dev only. In prod list the real origins, like
# ALLOWED_ORIGINS=https://watchflame-wildfire.com,https://www.watchflame-wildfire.com,http://localhost:3000
ALLOWED_ORIGINS=*

# slowapi limit strings. Cached endpoints take the default. The ones that cost an
# upstream call (/risk /trajectory /weather /geocode /shelters) get the tighter one.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_EXPENSIVE=20/minute

# Body size cap in bytes. Guards POST /risk.
MAX_REQUEST_BYTES=16384
