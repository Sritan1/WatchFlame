# Copy to .env (gitignored).
#
# On the phone (Expo Go), EXPO_PUBLIC_API_URL must be reachable from the device.
# - Phone & laptop on same Wi-Fi: use laptop LAN IP, e.g. http://192.168.1.42:8000
#   Find it in PowerShell with: ipconfig | Select-String IPv4
# - Different networks / hotel Wi-Fi blocks LAN: run `npx expo start --tunnel`
#   and the API URL still must be a public host (Railway URL once deployed).
# - Production: https://your-app.up.railway.app
#
EXPO_PUBLIC_API_URL=http://localhost:8000
